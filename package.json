{
  "name": "brackeroni",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib",
    "format:check": "prettier --check components/brackets/configuration",
    "test": "vitest run",
    "test:ui": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:db": "vitest run test/repository-read-smoke.test.mjs",
    "db:migrate": "node scripts/run-migrations.mjs",
    "db:check": "node scripts/check-db.mjs",
    "db:diagnostics": "node scripts/db-diagnostics.mjs",
    "db:diagnostics:reset": "node scripts/db-diagnostics.mjs reset",
    "db:seed-pagination": "node scripts/seed-pagination-pools.mjs",
    "db:seed-pagination:clear": "node scripts/seed-pagination-pools.mjs clear",
    "db:seed-completed": "node scripts/seed-completed-brackets.mjs",
    "db:seed-completed:clear": "node scripts/seed-completed-brackets.mjs clear",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "lucide-react": "^1.25.0",
    "next": "^16.0.0",
    "next-auth": "^4.24.14",
    "postgres": "^3.4.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.11",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "jsdom": "^29.1.1",
    "prettier": "3.9.6",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
